{
  "expo": {
    "name": "SelectableText",
    "slug": "react-native-selectable-text-example",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "example",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.majornutcracker.reactnativeselectablewebview.example"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FEF5DA",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.majornutcracker.reactnativeselectablewebview.example"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FEF5DA",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
