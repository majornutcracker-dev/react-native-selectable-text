# https://editorconfig.org
# Covers the native sources (Kotlin/Swift/Gradle) that Prettier does not touch.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts,gradle}]
indent_size = 4

[*.swift]
indent_size = 2

[*.md]
# Trailing whitespace is a hard line break in Markdown.
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
